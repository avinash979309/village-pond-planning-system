# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ─── CORS (comma-separated list of allowed origins) ─────────────────────────
# In development the React Vite dev server runs on port 5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local MongoDB (Phase 2 does not require persistence; set to empty to skip)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pond_planner

# ─── External APIs ───────────────────────────────────────────────────────────
# Register free API key at: https://portal.opentopography.org/
OPENTOPOGRAPHY_API_KEY=your_api_key_here

# ─── Upload limits ───────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ─── Geospatial processing defaults ──────────────────────────────────────────
# Grid resolution (cells per axis) for contour interpolation
DEFAULT_GRID_RESOLUTION=200
# Percentage of cells with highest flow accumulation treated as drainage channels
DEFAULT_DRAINAGE_THRESHOLD_PCT=2.0
# Grid cells of buffer to apply around drainage channels (exclusion zone)
DEFAULT_DRAINAGE_BUFFER_CELLS=2
# Grid cells search radius for snapping pond candidate to pour point
DEFAULT_SNAP_RADIUS_CELLS=5
